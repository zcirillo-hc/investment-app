{
  "name": "spare-change",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lint:copy && npm run lint:advice && npm run rules:check",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "postbuild": "tsx scripts/check-bundle-secrets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "e2e": "playwright test",
    "db:migrate": "tsx db/migrate.ts",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "lint:advice": "tsx scripts/lint-advice.ts",
    "rules:check": "tsx scripts/check-rules.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "web-push": "^3.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.47.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^12.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
